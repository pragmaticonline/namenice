{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "namenice",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ROOT_DOMAIN": "namenice.net",
    "CNAME_TARGET": "fallback.blognice.com"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "namenice",
      "database_id": "6c70b9a8-e797-4c22-8f0f-4fcd133501bd"
    },
    {
      "binding": "POSTS",
      "database_name": "namenice-posts",
      "database_id": "5ef77306-35a5-4941-a80e-300d8975a2a7"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "namenice-media"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "METRICS",
      "dataset": "namenice_pageviews"
    },
    {
      "binding": "EVENTS",
      "dataset": "namenice_events"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "15 2 * * *"
    ]
  }
}